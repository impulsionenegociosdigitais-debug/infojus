# Token da API do ADVbox (gerado nas configurações de API do ADVbox)
ADVBOX_API_TOKEN=

# Usuários do painel, no formato usuario:senha, separados por vírgula.
# A senha pode ser gravada criptografada com: npm run hash-password -- usuario
# Obrigatório quando o painel for publicado fora deste computador.
DASHBOARD_USERS=

# Opcional: chave para assinar as sessões de login (texto aleatório longo).
# Sem ela, a chave é derivada da lista de usuários.
# SESSION_SECRET=

# Opcionais
# ADVBOX_BASE_URL=https://app.advbox.com.br/api/v1
# PORT=3000
# HOST=127.0.0.1
# Tempo de cache dos dados, em minutos
# CACHE_MINUTES=15
# Use 1 quando o painel estiver atrás de um proxy HTTPS (a Vercel já é detectada sozinha)
# TRUST_PROXY=1
# Força o uso de dados de demonstração
# ADVBOX_DEMO=1
